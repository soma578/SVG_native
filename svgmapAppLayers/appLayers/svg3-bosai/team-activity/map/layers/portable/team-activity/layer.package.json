{
  "id": "teamActivity",
  "title": "Team Activity Portable Layer",
  "version": "1.2.0",
  "entrypoint": "teamActivityLayer.svg",
  "type": "svgmap-portable-layer",
  "distribution": {
    "publisher": { "id": "svg3", "name": "SVG3" },
    "license": { "spdx": "NOASSERTION", "name": "利用条件未設定", "status": "unresolved", "redistributable": false },
    "publishedAt": "2026-07-21T00:00:00+09:00"
  },
  "portability": {
    "level": "distribution-portable",
    "dataInjection": "hash-params",
    "bundleDataDefaults": "svg-document-attributes",
    "limitations": []
  },
  "runtime": {
    "lawaModes": ["tight", "isolated"],
    "readyEvent": "layerWebAppReady",
    "requiredApis": ["svgMap.getGeoViewBox", "svgMap.setShowPoiProperty", "svgMap.showModal", "svgImage"]
  },
  "runtimeDependencies": [
    { "id": "representative-pins", "version": "1.2.3", "manifest": "../representative-pins/runtime.package.json" },
    { "id": "svgmap-slawa-client", "version": "1.0.0", "manifest": "../svgmap-slawa-client/runtime.package.json" }
  ],
  "detailMode": "svgMap.showModal",
  "shared": [
    "teamActivityDetail.js",
    "teamActivityCsv.js",
    "teamActivityAreaCore.js",
    "appLayersAdmin.html",
    "teamActivityAreaLayer.svg",
    "teamActivityAreaLayer.html"
  ],
  "containerAnimations": [
    {
      "id": "layer-team-activity",
      "entrypoint": "teamActivityLayer.svg",
      "title": "チーム活動",
      "class": "poi clickable",
      "opacity": "1",
      "primary": true,
      "dataParams": ["summary", "data", "sourceCsv", "districtSvgUrlTemplate", "layer"]
    }
  ],
  "data": {
    "kind": "qtct",
    "injection": {
      "transport": "svg-fragment-query",
      "required": ["data", "layer"],
      "optional": ["summary", "sourceCsv", "statusOverlay", "profile", "municipalityCodes", "districtSvgUrlTemplate"]
    }
  },
  "containerAnimation": {
    "class": "poi clickable",
    "visibility": "hidden",
    "opacity": "1"
  }
}
