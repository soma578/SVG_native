# Configure these in .env.local and in Vercel server-side environment variables.
# Do not use NEXT_PUBLIC_ or commit the actual values.
SVG3_PRIVATE_SHEET_ID=PASTE_SPREADSHEET_ID_OR_EDIT_URL_HERE
SVG3_PRIVATE_SHEET_RANGE=Sheet1!A:Z
SVG3_PRIVATE_SHEET_COLUMNS={"id":0,"title":2,"lat":7,"lon":8,"imageUrl":10,"descriptionColumns":[3,4,5,6]}
SVG3_GOOGLE_SERVICE_ACCOUNT_JSON=PASTE_SERVICE_ACCOUNT_JSON_HERE
